{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "kind": {
      "type": "string",
      "enum": [
        "summary",
        "abridgement",
        "notes"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-zA-Z]{2,8}(?:-[a-zA-Z0-9]{1,8})*$"
    },
    "tags": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "coverImageDataUrl": {
      "type": "string"
    },
    "chapters": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "paragraphs": {
            "minItems": 1,
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            }
          }
        },
        "required": [
          "title",
          "paragraphs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "author",
    "chapters"
  ],
  "additionalProperties": false
}
